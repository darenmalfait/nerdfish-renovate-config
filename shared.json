{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:react",
    "group:monorepos",
    "group:allDigest",
    "group:linters",
    "helpers:pinGitHubActionDigests",
    "replacements:all",
    "workarounds:all",
    ":ignoreUnstable",
    ":semanticCommits",
    ":semanticPrefixFixDepsChoreOthers",
    ":separateMultipleMajorReleases"
  ],
  "gitAuthor": "Nerdfish Renovate Bot <56068461+darenmalfait@users.noreply.github.com>",
  "timezone": "Europe/Paris",
  "labels": ["dependencies"],
  "minimumReleaseAge": "7 days",
  "ignorePresets": [":prHourlyLimit4"],
  "vulnerabilityAlerts": {
    "description": "Be sure that the Dependency graph and Dependabot alerts are enabled for the repo. Details: https://docs.renovatebot.com/configuration-options/#vulnerabilityalerts",
    "enabled": true,
    "addLabels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "prCreation": "not-pending",
  "prConcurrentLimit": 2,
  "branchConcurrentLimit": 2,
  "rangeStrategy": "bump",
  "rebaseWhen": "conflicted",
  "lockFileMaintenance": {
    "enabled": false
  },
  "postUpdateOptions": ["pnpmDedupe"],
  "toolSettings": {
    "nodeMaxMemory": 1536
  },
  "env": {
    "PNPM_MAX_WORKERS": "1",
    "PNPM_CONFIG_TRUST_LOCKFILE": "true"
  },
  "packageRules": [
    {
      "description": "pnpm major bumps are too heavy for Mend's 3GB runner — do them manually",
      "matchManagers": ["npm"],
      "matchPackageNames": ["pnpm"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
